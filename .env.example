# PostgreSQL & PostGIS Configuration
DATABASE_URL=postgresql://vitoria_user:vitoria_password@localhost:5432/vitoria_turismo
PGHOST=localhost
PGPORT=5432
PGUSER=vitoria_user
PGPASSWORD=vitoria_password
PGDATABASE=vitoria_turismo

# Server Port
PORT=3001

# Vitoria-Gasteiz Bounding Box Bounds
# ST_MakeEnvelope(-2.77, 42.78, -2.57, 42.92, 4326)
BBOX_MIN_LON=-2.77
BBOX_MIN_LAT=42.78
BBOX_MAX_LON=-2.57
BBOX_MAX_LAT=42.92

# City Center Point (Plaza de la Virgen Blanca)
CENTER_LON=-2.6716
CENTER_LAT=42.8467

# Frontend CARTO Basemaps API Key
VITE_CARTO_API_KEY=cb1_3j0b_1_4d602ffc3a4aaf07e24b001b
